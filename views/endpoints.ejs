<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OSINT API HUB | Endpoints Explorer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0b0f19',
                        cardBg: '#111827',
                        borderBg: '#1f2937',
                        accentBlue: '#3b82f6',
                        accentPurple: '#8b5cf6',
                        accentCyan: '#06b6d4',
                        accentGreen: '#10b981',
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #0b0f19; color: #f3f4f6; }
        code, pre { font-family: 'Fira Code', monospace; }
        
        /* Glassmorphism & Neon Glows */
        .glass-card { background: rgba(17, 24, 39, 0.75); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .glass-card-hover { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .glass-card-hover:hover { transform: translateY(-4px); border-color: rgba(59, 130, 246, 0.4); box-shadow: 0 10px 30px -10px rgba(59, 130, 246, 0.2); }
        .glow-cyan { box-shadow: 0 0 25px rgba(6, 182, 212, 0.15); }
        .glow-blue { box-shadow: 0 0 25px rgba(59, 130, 246, 0.15); }

        /* Smooth Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0b0f19; }
        ::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #374151; }

        /* Cyberpunk Grid Background */
        .bg-grid {
            background-size: 30px 30px;
            background-image: linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        }

        /* Animated Pulsing Status Dot */
        .status-dot {
            box-shadow: 0 0 10px #10b981;
        }
    </style>
</head>
<body class="min-h-screen bg-grid pb-16">

    <!-- Top Navigation -->
    <nav class="glass-card sticky top-0 z-50 border-b border-gray-800 px-6 py-4 mb-8">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="/" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-blue-600 to-purple-600 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition">
                    <i class="fa-solid fa-code text-sm"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-lg tracking-wide text-white">OSINT <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">API HUB</span></h1>
                    <p class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold">Endpoints Portal</p>
                </div>
            </a>

            <div class="flex items-center space-x-3">
                <a href="/docs" class="text-xs bg-gray-800/80 hover:bg-gray-700 text-gray-200 px-3.5 py-2 rounded-xl transition border border-gray-700/80 flex items-center space-x-2">
                    <i class="fa-solid fa-book text-cyan-400"></i>
                    <span class="hidden sm:inline font-medium">Full Docs</span>
                </a>

                <% if (user) { %>
                    <a href="/admin/dashboard" class="text-xs bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold px-4 py-2 rounded-xl transition shadow-lg shadow-blue-500/20 flex items-center space-x-2">
                        <i class="fa-solid fa-gauge"></i>
                        <span>Dashboard</span>
                    </a>
                <% } else { %>
                    <a href="/login" class="text-xs bg-blue-600/20 hover:bg-blue-600/30 text-blue-400 font-semibold px-4 py-2 rounded-xl border border-blue-500/30 transition flex items-center space-x-1.5">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        <span>Admin Login</span>
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6">

        <!-- HERO SECTION -->
        <div class="text-center my-10 max-w-3xl mx-auto">
            <span class="bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-widest">
                <i class="fa-solid fa-bolt mr-1.5"></i> High Performance Endpoints
            </span>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-white mt-4 tracking-tight">
                Explore Available <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500">APIs</span>
            </h2>
            <p class="text-gray-400 text-sm sm:text-base mt-3">
                Test and integrate powerful OSINT endpoints directly in real-time. Use your secret key to fetch instant live JSON data.
            </p>
        </div>

        <!-- SEARCH AND FILTER BAR -->
        <div class="glass-card rounded-2xl p-4 border border-gray-800 mb-8 max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="relative w-full md:w-2/3">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
                <input type="text" id="endpointSearch" onkeyup="filterEndpoints()" placeholder="Search endpoints (e.g., leakpro, vehicle, phone)..." class="w-full bg-gray-900/90 border border-gray-800 rounded-xl pl-11 pr-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 transition">
            </div>

            <div class="flex items-center space-x-2 w-full md:w-auto justify-end">
                <span class="text-xs text-gray-400 font-medium">Total:</span>
                <span class="bg-cyan-500/10 text-cyan-400 font-mono text-xs font-bold px-3 py-1 rounded-lg border border-cyan-500/20" id="endpointCount"><%= apis.length %> Services</span>
            </div>
        </div>

        <!-- ENDPOINTS GRID -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="endpointsGrid">
            <% if (apis.length === 0) { %>
                <div class="col-span-full text-center py-16 glass-card rounded-2xl">
                    <i class="fa-solid fa-server text-4xl text-gray-600 mb-3"></i>
                    <p class="text-gray-400 text-sm font-medium">No endpoints are active right now.</p>
                </div>
            <% } %>

            <% apis.forEach(function(api) { %>
                <div class="glass-card glass-card-hover rounded-2xl p-6 border border-gray-800/80 flex flex-col justify-between endpoint-card" data-name="<%= api.display_name.toLowerCase() %>" data-endpoint="<%= api.endpoint.toLowerCase() %>">
                    <div>
                        <!-- Header / Status -->
                        <div class="flex items-center justify-between mb-4">
                            <span class="bg-emerald-500/10 text-emerald-400 text-[10px] font-bold px-2.5 py-1 rounded-lg border border-emerald-500/20 flex items-center space-x-1.5 uppercase tracking-wider">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 status-dot"></span>
                                <span>GET</span>
                            </span>
                            <span class="text-[11px] font-mono text-gray-500">JSON</span>
                        </div>

                        <!-- API Name & Description -->
                        <h3 class="text-lg font-bold text-white flex items-center space-x-2">
                            <span><%= api.display_name %></span>
                        </h3>
                        <p class="text-xs text-gray-400 mt-2 leading-relaxed min-h-[36px]">
                            <%= api.description || 'Provides comprehensive OSINT data analysis and record lookup.' %>
                        </p>

                        <!-- Route & Parameter -->
                        <div class="mt-4 bg-gray-900/90 rounded-xl p-3 border border-gray-800 font-mono text-xs space-y-2">
                            <div class="flex items-center justify-between text-cyan-400 font-semibold truncate">
                                <span><%= api.endpoint %></span>
                                <button onclick="copyText('<%= baseUrl %><%= api.endpoint %>')" class="text-gray-500 hover:text-white transition ml-2" title="Copy Path">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                            <div class="text-[11px] text-gray-400 border-t border-gray-800/80 pt-2 flex items-center justify-between">
                                <span>Req Param:</span>
                                <code class="text-purple-400 font-bold bg-purple-500/10 px-1.5 py-0.5 rounded border border-purple-500/20"><%= api.param_name %></code>
                            </div>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <div class="mt-6 pt-4 border-t border-gray-800/60 flex items-center justify-between">
                        <button onclick="openTesterModal('<%= api.display_name %>', '<%= api.endpoint %>', '<%= api.param_name %>', '<%= api.param_example %>')" class="w-full bg-gradient-to-r from-cyan-600/20 to-blue-600/20 hover:from-cyan-600/30 hover:to-blue-600/30 text-cyan-300 font-semibold text-xs py-2.5 px-4 rounded-xl border border-cyan-500/30 transition flex items-center justify-center space-x-2 group">
                            <i class="fa-solid fa-terminal text-cyan-400 group-hover:rotate-12 transition transform"></i>
                            <span>Test Live Endpoint</span>
                        </button>
                    </div>
                </div>
            <% }); %>
        </div>

    </main>

    <!-- ================= MODAL: LIVE API TESTER CONSOLE ================= -->
    <div id="testerModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-card border border-gray-800 w-full max-w-2xl rounded-2xl p-6 relative shadow-2xl max-h-[90vh] flex flex-col justify-between">
            
            <!-- Close Button -->
            <button onclick="closeModal('testerModal')" class="absolute top-4 right-4 text-gray-400 hover:text-white text-lg w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center transition">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div>
                <!-- Header -->
                <div class="flex items-center space-x-3 mb-4">
                    <div class="w-9 h-9 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center font-bold">
                        <i class="fa-solid fa-vial"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-white" id="modalApiTitle">Test Endpoint</h3>
                        <p class="text-xs font-mono text-cyan-400" id="modalApiEndpoint"></p>
                    </div>
                </div>

                <!-- Input Controls -->
                <div class="space-y-3 my-4 text-xs">
                    <div>
                        <label class="block text-gray-400 font-medium mb-1">Your API Key <span class="text-red-400">*</span></label>
                        <input type="text" id="testApiKey" placeholder="OSINT_XXXXXXX" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2.5 text-white font-mono focus:outline-none focus:border-cyan-500">
                    </div>

                    <div>
                        <label class="block text-gray-400 font-medium mb-1" id="modalParamLabel">Parameter</label>
                        <input type="text" id="testParamValue" placeholder="Enter value..." class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2.5 text-white font-mono focus:outline-none focus:border-cyan-500">
                    </div>

                    <button id="runTestBtn" onclick="executeApiTest()" class="w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-semibold py-2.5 rounded-xl transition shadow-lg shadow-cyan-500/20 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>Send Request</span>
                    </button>
                </div>
            </div>

            <!-- Response Viewer Console -->
            <div class="mt-2">
                <div class="flex items-center justify-between mb-1.5">
                    <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">JSON Response Console</span>
                    <span id="testStatus" class="text-[10px] font-mono px-2 py-0.5 rounded hidden"></span>
                </div>
                <div class="bg-gray-950 border border-gray-800 rounded-xl p-3 h-48 overflow-y-auto font-mono text-xs text-green-400 relative">
                    <pre id="jsonOutput" class="whitespace-pre-wrap break-all">// Click "Send Request" to fetch live response...</pre>
                </div>
            </div>

        </div>
    </div>

    <!-- FOOTER -->
    <footer class="max-w-7xl mx-auto text-center mt-16 pt-8 border-t border-gray-800/80 text-xs text-gray-500">
        <p>OSINT API Hub &copy; 2026. Powered by Telegram Support <a href="https://t.me/<%= owner.replace('@','') %>" target="_blank" class="text-cyan-400 hover:underline"><%= owner %></a></p>
    </footer>

    <!-- JAVASCRIPT CONTROLLERS -->
    <script>
        let currentEndpoint = '';
        let currentParamName = '';

        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        function copyText(text) {
            navigator.clipboard.writeText(text);
            alert('Copied link: ' + text);
        }

        function filterEndpoints() {
            const query = document.getElementById('endpointSearch').value.toLowerCase();
            const cards = document.querySelectorAll('.endpoint-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const name = card.getAttribute('data-name');
                const endpoint = card.getAttribute('data-endpoint');
                if (name.includes(query) || endpoint.includes(query)) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            document.getElementById('endpointCount').innerText = `${visibleCount} Services`;
        }

        function openTesterModal(title, endpoint, paramName, paramExample) {
            currentEndpoint = endpoint;
            currentParamName = paramName;

            document.getElementById('modalApiTitle').innerText = title;
            document.getElementById('modalApiEndpoint').innerText = endpoint;
            document.getElementById('modalParamLabel').innerHTML = `Query Parameter: <code class="text-purple-400 font-bold">${paramName}</code>`;
            document.getElementById('testParamValue').value = paramExample || '';
            document.getElementById('testParamValue').placeholder = `Enter ${paramName}...`;
            document.getElementById('jsonOutput').innerText = '// Click "Send Request" to fetch live response...';
            document.getElementById('jsonOutput').className = 'whitespace-pre-wrap break-all text-green-400';
            
            const statusEl = document.getElementById('testStatus');
            statusEl.classList.add('hidden');

            openModal('testerModal');
        }

        function executeApiTest() {
            const apiKey = document.getElementById('testApiKey').value.trim();
            const paramVal = document.getElementById('testParamValue').value.trim();
            const outputEl = document.getElementById('jsonOutput');
            const statusEl = document.getElementById('testStatus');

            if (!apiKey) {
                alert('Please enter an API Key!');
                return;
            }

            outputEl.innerText = 'Fetching response from server...';
            outputEl.className = 'whitespace-pre-wrap break-all text-cyan-300 animate-pulse';

            const testUrl = `${currentEndpoint}?key=${encodeURIComponent(apiKey)}&${encodeURIComponent(currentParamName)}=${encodeURIComponent(paramVal)}`;

            const startTime = performance.now();

            fetch(testUrl)
            .then(async response => {
                const endTime = performance.now();
                const duration = Math.round(endTime - startTime);
                const data = await response.json();

                statusEl.classList.remove('hidden');
                if (response.ok) {
                    statusEl.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
                    statusEl.innerText = `STATUS: 200 OK (${duration}ms)`;
                    outputEl.className = 'whitespace-pre-wrap break-all text-green-400';
                } else {
                    statusEl.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20';
                    statusEl.innerText = `STATUS: ${response.status} ERROR (${duration}ms)`;
                    outputEl.className = 'whitespace-pre-wrap break-all text-red-400';
                }

                outputEl.innerText = JSON.stringify(data, null, 2);
            })
            .catch(err => {
                statusEl.classList.remove('hidden');
                statusEl.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20';
                statusEl.innerText = 'REQUEST FAILED';
                outputEl.className = 'whitespace-pre-wrap break-all text-red-400';
                outputEl.innerText = JSON.stringify({ error: 'Failed to connect to API endpoint', details: err.message }, null, 2);
            });
        }
    </script>
</body>
</html>
