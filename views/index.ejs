<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AllAPI — OSINT Intelligence Hub</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  :root {
    --bg:       #0b0612;
    --bg2:      #150a22;
    --bg3:      #1a0d2b;
    --surface:  rgba(26, 13, 43, 0.6);
    --border:   rgba(255, 61, 129, 0.16);
    --border2:  rgba(255,255,255,0.07);
    --cyan:     #ff3d81;   /* primary → hot pink */
    --cyan2:    #e11d74;
    --violet:   #a855f7;   /* purple */
    --emerald:  #2dd4bf;   /* teal */
    --amber:    #fb923c;   /* orange */
    --red:      #f43f5e;
    --pink:     #f472b6;
    --text:     #f1e9f5;
    --muted:    #8b7a9c;
    --muted2:   #4b3a5e;
    --mono:     'JetBrains Mono', monospace;
    --sans:     'Plus Jakarta Sans', 'Inter', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background:
      radial-gradient(1100px 700px at 12% -5%, rgba(168,85,247,0.16), transparent 58%),
      radial-gradient(1000px 650px at 92% 0%, rgba(255,61,129,0.14), transparent 55%),
      var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* ── BACKGROUND GRID + GLOW ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,61,129,0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(168,85,247,0.022) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .glow-orb {
    position: fixed;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    filter: blur(80px);
    opacity: 0.2;
  }
  .glow-orb.g1 { width: 600px; height: 600px; background: var(--cyan); top: -150px; left: -100px; }
  .glow-orb.g2 { width: 500px; height: 500px; background: var(--violet); bottom: -100px; right: -100px; }
  .glow-orb.g3 { width: 300px; height: 300px; background: var(--amber); top: 40%; left: 50%; transform: translate(-50%,-50%); opacity: 0.09; }

  /* ── NAVBAR ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 16px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(11,6,18,0.72);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border2);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--sans);
    font-weight: 800;
    font-size: 19px;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.5px;
  }
  .nav-logo .logo-bracket { color: var(--muted); }
  .nav-logo .logo-mark {
    width: 34px; height: 34px; border-radius: 10px;
    background: linear-gradient(135deg, var(--cyan), var(--violet));
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 15px;
    box-shadow: 0 8px 22px rgba(255,61,129,0.35);
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.7); }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
  }
  .nav-links a {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--cyan); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-nav {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 99px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--cyan);
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .btn-nav:hover { background: rgba(255,61,129,0.08); border-color: var(--cyan); }
  .btn-nav.filled { background: linear-gradient(135deg, var(--cyan), var(--violet)); color: #fff; border-color: transparent; font-weight: 700; }
  .btn-nav.filled:hover { box-shadow: 0 8px 24px rgba(255,61,129,0.4); }

  /* ── HERO ── */
  .hero {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 120px 24px 80px;
    text-align: center;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--cyan);
    background: rgba(255,61,129,0.08);
    border: 1px solid rgba(255,61,129,0.22);
    padding: 7px 16px;
    border-radius: 100px;
    letter-spacing: 0.1em;
    margin-bottom: 32px;
    animation: fadeInDown 0.6s ease both;
  }
  .hero-tag .dot { width: 5px; height: 5px; background: var(--cyan); border-radius: 50%; animation: pulse-dot 2s ease-in-out infinite; }

  .hero-title {
    font-family: var(--sans);
    font-size: clamp(48px, 8vw, 98px);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -3px;
    margin-bottom: 24px;
    animation: fadeInUp 0.6s ease 0.1s both;
  }
  .hero-title .line1 { display: block; color: var(--text); }
  .hero-title .line2 {
    display: block;
    background: linear-gradient(120deg, var(--cyan) 0%, var(--violet) 50%, var(--amber) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 18px;
    color: var(--muted);
    max-width: 540px;
    margin: 0 auto 48px;
    font-weight: 400;
    animation: fadeInUp 0.6s ease 0.2s both;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeInUp 0.6s ease 0.3s both;
    margin-bottom: 80px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 700;
    padding: 15px 30px;
    border-radius: 99px;
    background: linear-gradient(135deg, var(--cyan), var(--violet));
    color: #fff;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.01em;
    box-shadow: 0 10px 30px rgba(255,61,129,0.3);
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 40px rgba(255,61,129,0.42); }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    padding: 15px 30px;
    border-radius: 99px;
    background: rgba(255,255,255,0.04);
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border2);
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-ghost:hover { border-color: var(--border); background: rgba(255,61,129,0.06); }

  /* ── TERMINAL PREVIEW ── */
  .terminal-wrap {
    width: 100%;
    max-width: 760px;
    animation: fadeInUp 0.6s ease 0.4s both;
  }

  .terminal {
    background: rgba(16, 8, 26, 0.92);
    border: 1px solid rgba(255,61,129,0.22);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.03), inset 0 1px 0 rgba(255,255,255,0.05);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid var(--border2);
  }
  .t-dot { width: 12px; height: 12px; border-radius: 50%; }
  .t-dot.red  { background: #ff5f57; }
  .t-dot.yel  { background: #ffbd2e; }
  .t-dot.grn  { background: #28c840; }
  .t-url {
    flex: 1;
    text-align: center;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    background: rgba(0,0,0,0.3);
    padding: 4px 12px;
    border-radius: 5px;
    border: 1px solid var(--border2);
  }

  .terminal-body {
    padding: 20px 24px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 2;
  }
  .t-line { display: flex; gap: 10px; }
  .t-prompt { color: var(--cyan); flex-shrink: 0; }
  .t-cmd    { color: var(--text); }
  .t-out    { color: var(--muted); padding-left: 20px; }
  .t-json   { color: var(--emerald); padding-left: 20px; }
  .t-key    { color: var(--violet); }
  .t-val    { color: var(--amber); }
  .t-cursor {
    display: inline-block;
    width: 8px; height: 14px;
    background: var(--cyan);
    vertical-align: middle;
    animation: blink 1.1s step-end infinite;
    margin-left: 2px;
  }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* ── STATS STRIP ── */
  .stats-strip {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
    animation: fadeInUp 0.6s ease 0.5s both;
  }

  .stat-box {
    background: var(--surface);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border2);
    padding: 32px 24px;
    text-align: center;
    transition: border-color 0.3s, transform 0.3s;
  }
  .stat-box:first-child { border-radius: 16px 0 0 16px; }
  .stat-box:last-child  { border-radius: 0 16px 16px 0; }
  .stat-box:hover { border-color: var(--border); transform: translateY(-2px); }

  .stat-num {
    font-family: var(--mono);
    font-size: 36px;
    font-weight: 700;
    color: var(--cyan);
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── SECTION SHARED ── */
  section {
    position: relative;
    z-index: 1;
    padding: 100px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--cyan);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .section-eyebrow::before { content: '//'; color: var(--muted2); }

  .section-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -1.5px;
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .section-sub {
    font-size: 16px;
    color: var(--muted);
    max-width: 480px;
    margin-bottom: 56px;
  }

  /* ── ENDPOINTS GRID ── */
  .endpoints-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .ep-card {
    background: var(--surface);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border2);
    border-radius: 16px;
    padding: 20px;
    transition: all 0.25s;
    cursor: default;
    position: relative;
    overflow: hidden;
  }
  .ep-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan), var(--violet), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .ep-card:hover { border-color: rgba(255,61,129,0.3); transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.35); }
  .ep-card:hover::before { opacity: 1; }

  .ep-emoji {
    width: 48px; height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(255,61,129,0.18), rgba(168,85,247,0.18));
    border: 1px solid rgba(255,61,129,0.14);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px;
    margin-bottom: 14px;
    box-shadow: 0 8px 18px rgba(0,0,0,0.25);
  }

  .ep-name {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 4px;
  }

  .ep-path {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--cyan);
    margin-bottom: 8px;
  }

  .ep-desc {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.5;
  }

  .ep-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 99px;
    background: rgba(255,61,129,0.1);
    color: var(--cyan);
    border: 1px solid rgba(255,61,129,0.2);
    margin-top: 10px;
  }

  /* ── HOW IT WORKS ── */
  .steps-wrap {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .step-card {
    background: var(--surface);
    border: 1px solid var(--border2);
    border-radius: 20px;
    padding: 32px;
    position: relative;
    transition: border-color 0.3s, transform 0.3s;
  }
  .step-card:hover { border-color: rgba(255,61,129,0.25); transform: translateY(-3px); }

  .step-num {
    font-family: var(--mono);
    font-size: 48px;
    font-weight: 900;
    color: rgba(255,61,129,0.14);
    line-height: 1;
    margin-bottom: 16px;
    letter-spacing: -2px;
  }

  .step-icon {
    width: 48px; height: 48px;
    background: linear-gradient(135deg, var(--cyan), var(--violet));
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 18px;
    margin-bottom: 16px;
    box-shadow: 0 8px 20px rgba(255,61,129,0.3);
  }

  .step-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
    letter-spacing: -0.3px;
  }

  .step-desc {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  /* ── PROFILE SECTION ── */
  .profile-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .profile-left .label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--cyan);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .profile-left .label::before { content: '//'; color: var(--muted2); }

  .profile-name {
    font-size: 48px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -2px;
    line-height: 1;
    margin-bottom: 8px;
  }
  .profile-name span {
    background: linear-gradient(135deg, var(--cyan), var(--violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .profile-handle {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .profile-bio {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 400px;
  }

  .social-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    padding: 11px 20px;
    border-radius: 99px;
    border: 1px solid var(--border2);
    color: var(--text);
    text-decoration: none;
    background: var(--surface);
    transition: all 0.2s;
    backdrop-filter: blur(10px);
  }
  .social-btn:hover { border-color: var(--border); background: rgba(255,61,129,0.06); color: var(--cyan); }
  .social-btn i { font-size: 14px; }

  .profile-right {
    position: relative;
  }

  .terminal-mini {
    background: rgba(16,8,26,0.92);
    border: 1px solid rgba(255,61,129,0.22);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0,0,0,0.4);
  }

  .tm-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid var(--border2);
  }
  .tm-dot { width: 10px; height: 10px; border-radius: 50%; }
  .tm-title {
    flex: 1;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted2);
    text-align: center;
  }

  .tm-body {
    padding: 20px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.9;
  }
  .tm-comment { color: var(--muted2); }
  .tm-key-c   { color: var(--violet); }
  .tm-str     { color: var(--amber); }
  .tm-num     { color: var(--cyan); }
  .tm-bool    { color: var(--emerald); }
  .tm-punc    { color: var(--muted); }

  .float-badge {
    position: absolute;
    top: -16px; right: -16px;
    background: rgba(45, 212, 191, 0.15);
    border: 1px solid rgba(45, 212, 191, 0.3);
    color: var(--emerald);
    font-family: var(--mono);
    font-size: 11px;
    padding: 8px 14px;
    border-radius: 99px;
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .float-badge .fb-dot { width: 7px; height: 7px; background: var(--emerald); border-radius: 50%; animation: pulse-dot 2s ease-in-out infinite; }

  /* ── CHANNELS SECTION ── */
  .channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .channel-card {
    background: var(--surface);
    border: 1px solid var(--border2);
    border-radius: 20px;
    padding: 28px;
    text-decoration: none;
    transition: all 0.25s;
    display: flex;
    align-items: flex-start;
    gap: 18px;
    position: relative;
    overflow: hidden;
  }
  .channel-card:hover { transform: translateY(-4px); box-shadow: 0 20px 50px rgba(0,0,0,0.35); }

  .channel-card.tg-main { border-color: rgba(255,61,129,0.2); }
  .channel-card.tg-main:hover { border-color: rgba(255,61,129,0.5); background: rgba(255,61,129,0.04); }

  .channel-card.tg-vip  { border-color: rgba(168,85,247,0.2); }
  .channel-card.tg-vip:hover  { border-color: rgba(168,85,247,0.5); background: rgba(168,85,247,0.04); }

  .channel-card.tg-dev  { border-color: rgba(45,212,191,0.2); }
  .channel-card.tg-dev:hover  { border-color: rgba(45,212,191,0.5); background: rgba(45,212,191,0.04); }

  .ch-icon {
    width: 54px; height: 54px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    color: #fff;
  }
  .ch-icon.c1 { background: linear-gradient(135deg, #ff3d81, #e11d74); }
  .ch-icon.c2 { background: linear-gradient(135deg, #a855f7, #6366f1); }
  .ch-icon.c3 { background: linear-gradient(135deg, #2dd4bf, #06b6d4); }

  .ch-info {}
  .ch-name { font-weight: 700; font-size: 16px; color: var(--text); margin-bottom: 4px; }
  .ch-desc { font-size: 13px; color: var(--muted); line-height: 1.5; margin-bottom: 10px; }
  .ch-link {
    font-family: var(--mono);
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .channel-card.tg-main .ch-link { color: var(--cyan); }
  .channel-card.tg-vip .ch-link  { color: var(--violet); }
  .channel-card.tg-dev .ch-link  { color: var(--emerald); }

  .ch-arrow {
    position: absolute;
    top: 24px; right: 24px;
    color: var(--muted2);
    font-size: 14px;
    transition: transform 0.2s, color 0.2s;
  }
  .channel-card:hover .ch-arrow { transform: translate(2px, -2px); color: var(--text); }

  /* ── FOOTER ── */
  footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border2);
    padding: 48px 48px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-brand {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .footer-brand strong { color: var(--cyan); }

  .footer-links {
    display: flex;
    gap: 24px;
    list-style: none;
  }
  .footer-links a {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted2);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--cyan); }

  .footer-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--emerald);
  }
  .footer-status .sd { width: 6px; height: 6px; background: var(--emerald); border-radius: 50%; animation: pulse-dot 2s ease-in-out infinite; }

  /* ── DIVIDER ── */
  .divider {
    position: relative;
    z-index: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border2), transparent);
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    nav { padding: 14px 20px; }
    .nav-links { display: none; }
    .hero-title { letter-spacing: -2px; }
    .stats-strip { grid-template-columns: repeat(2, 1fr); }
    .stat-box:first-child { border-radius: 16px 0 0 0; }
    .stat-box:nth-child(2) { border-radius: 0 16px 0 0; }
    .stat-box:nth-child(3) { border-radius: 0 0 0 16px; }
    .stat-box:last-child   { border-radius: 0 0 16px 0; }
    .steps-wrap  { grid-template-columns: 1fr; }
    .profile-wrap { grid-template-columns: 1fr; gap: 40px; }
    footer { padding: 32px 20px 24px; }
  }
</style>
</head>
